# Development / live-feed environment. Copy to .env.dev and fill in.
# NEVER commit the real .env.dev file.

ENV_NAME=dev

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/btc_bot_dev

# bitFlyer Lightning API (only used when USE_LIVE_API=true)
# Use a READ-ONLY key: the execution layer (src/execution/) only reads account /
# positions / orders / executions — it does NOT place orders. Set USE_LIVE_API=true
# only to enable the live read client. NEVER commit the filled-in .env.dev.
# Verify with: uv run --env-file .env.dev python -m src.execution.account
USE_LIVE_API=false
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# Product (only traded instrument)
PRODUCT_CODE=FX_BTC_JPY

# Logging
LOG_LEVEL=INFO

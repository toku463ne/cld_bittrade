# Development / live-feed environment. Copy to .env.dev and fill in.
# NEVER commit the real .env.dev file.

ENV_NAME=dev

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/btc_bot_dev

# bitFlyer Lightning API. NEVER commit the filled-in .env.dev.
# Two independent gates (order placement needs BOTH true; the trade CLI also needs --execute):
#   USE_LIVE_API=true   -> enables live READS (account/positions/orders/executions, get_markets)
#   ALLOW_ORDERS=true   -> additionally enables ORDER placement (send/cancel)
# Start with ALLOW_ORDERS=false (read-only). Verify reads:
#   uv run --env-file .env.dev python -m src.execution.account
#   uv run --env-file .env.dev python -m src.execution.trade markets   # FX_BTC_JPY is the only shortable product
# Order placement is hard-capped to 0.001 BTC and dry-run unless --execute is passed.
USE_LIVE_API=false
ALLOW_ORDERS=false
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# Product (only traded instrument)
PRODUCT_CODE=FX_BTC_JPY

# Logging
LOG_LEVEL=INFO

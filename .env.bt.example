# Backtest (read-heavy) environment. Copy to .env.bt and fill in.
# NEVER commit the real .env.bt file. Never mix with .env.dev credentials.

ENV_NAME=bt

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/btc_bot_bt

# Backtest never touches the live API.
USE_LIVE_API=false

# Product (only traded instrument)
PRODUCT_CODE=FX_BTC_JPY

# Logging
LOG_LEVEL=INFO

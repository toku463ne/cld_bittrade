# Production (t3.micro) — LIVE trading box. Copy to .env.prod and fill in.
# NEVER commit the real .env.prod. Backtests stay on the dev PC (.env.bt); prod only
# runs the live auto-trader, so it needs no OHLCV import — just a small DB for the
# live trade records.

ENV_NAME=prod

# Database (created by scripts/setup_prod.sh; password is what you chose there)
DATABASE_URL=postgresql+psycopg2://btc_bot:CHANGE_ME@localhost:5432/btc_bot_prod

# GMO Coin — the live venue (leverage, shortable). Use a key WITH order permission.
GMO_API_KEY=
GMO_API_SECRET=

# Gates. Start in dry-run: USE_LIVE_API=true enables LIVE READS (so the trader can
# diff against your real positions); ALLOW_ORDERS=false means it places NO orders.
# Flip ALLOW_ORDERS=true ONLY after the dry-run log looks right and the manual
# round-trip works. (Order placement also needs explicit enabling in the trader.)
USE_LIVE_API=true
ALLOW_ORDERS=false

# Books to run: "name:symbol:slots,...". ALWAYS state :slots explicitly — an omitted
# count while EXEC_MAX_SLOTS>1 is clamped to 1 (the strategy class default, 12, must
# never decide a live book's size). For the first REAL trade, one XRP slot, min size:
#   AUTO_BOOKS=density_pullback_xrp:XRP_JPY:1
AUTO_BOOKS=density_pullback:BTC_JPY:6,density_pullback_xrp:XRP_JPY:6

# Largest book the executor may TRADE (default 1). A book with more slots than this is
# monitor-only, so raising the live slot count is always a deliberate env edit — and
# rollback is this one line. Compiled hard ceiling: 8.
# Shrinking below current occupancy trips the anomaly halt: set LIVE_DRAIN_OK=1 for that
# cycle (exits still maintained, no new entries) and unset once occupancy is back.
EXEC_MAX_SLOTS=6

# Per-book peak-notional guardrail, asserted at startup and in selfcheck: slots x min lot
# x price. A book that would breach it keeps managing exits but places NO entries — so a
# stale value here is a SILENT entry freeze. At 6 slots: BTC ~76k JPY (0.001 x 12.7M),
# XRP ~14k (10 x 227). Sized with headroom for price moves.
MAX_BOOK_NOTIONAL_JPY=120000

# Set to 1 ONLY to unfreeze a book whose every slot is a phantom (desired position with
# no live 建玉, created when a stateless replay grows a book). Costs trade-for-trade
# correspondence with the backtest, not risk — exposure is still capped at :slots.
# Unset once n_unadopted in logs/heartbeat.jsonl is back to 0.
#LIVE_IGNORE_PHANTOM_SLOTS=1

# bitFlyer is unused on prod (BTC-only / no XRP short) — leave blank.
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

LOG_LEVEL=INFO
